{
    "name": "ignited/laravel-crud",
    "description": "Generic data pages for Eloquent models: index, show, create, edit, delete and restore, built from each model's columns and casts.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": { "Ignited\\Crud\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Ignited\\Crud\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": { "providers": ["Ignited\\Crud\\CrudServiceProvider"] }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    }
}
